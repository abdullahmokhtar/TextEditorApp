@model Document
@using Microsoft.AspNetCore.Identity
@inject UserManager<IdentityUser> userManger
@{
    ViewData["Title"] = "Create";
}

<div class="row">
    <div class="">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <input asp-for="Title" placeholder="Title" class="form-control my-3" value="Untitled Document" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>
            <div class="form-group">
                <textarea id="tiny" asp-for="Content" class="form-control w-100"></textarea>
                <span asp-validation-for="Content" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="hidden" asp-for="UserId" value="@userManger.GetUserId(User)" class="form-control" />
            </div>
            <div class="form-group d-flex my-3">
                <input type="submit" value="Create" class="btn btn-primary" />
                <a class="btn btn-danger mx-3" asp-action="Index">Cancel</a>
            </div>
            <div class="form-group">
            </div>
        </form>
    </div>
</div>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
