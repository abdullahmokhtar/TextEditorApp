@model SignUpViewModel

@{
    ViewData["Title"] = "Registration Page";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<section class="signup mb-3">
    <div class="container">
        <div class="signup-content">
            <div class="signup-form">
                <h2 class="form-title">Sign up</h2>
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                <form method="POST" class="register-form" asp-action="Register" id="register-form">
                    <div class="form-group">
                        <label asp-for="UserName"><i class="zmdi zmdi-account material-icons-name"></i></label>
                        <input type="text" asp-for="UserName" placeholder="Your Name" />
                    </div>
                    <div class="form-group">
                        <label asp-for="Email"><i class="zmdi zmdi-email"></i></label>
                        <input type="email" asp-for="Email" id="email" placeholder="Your Email" />
                    </div>
                    <div class="form-group">
                        <label asp-for="Password"><i class="zmdi zmdi-lock"></i></label>
                        <input type="password" asp-for="Password" id="pass" placeholder="Password" />
                    </div>
                    <div class="form-group">
                        <label asp-for="ConfirmPassword"><i class="zmdi zmdi-lock-outline"></i></label>
                        <input asp-for="ConfirmPassword" type="password" id="re_pass" placeholder="Repeat your password" />
                    </div>
                    <div class="form-group">
                        <input asp-for="IsAgree" type="checkbox"  class="agree-term" />
                        <label asp-for="IsAgree" class="label-agree-term"><span><span></span></span>I agree all statements in  Terms of service</label>
                    </div>
                    <div class="form-group form-button">
                        <input type="submit" name="signup" id="signup" class="form-submit" value="Register" />
                    </div>
                </form>
            </div>
            <div class="signup-image">
                <figure><img src="~/images/signup-image.jpg" alt="sing up image"></figure>
                <a asp-action="Login" class="signup-image-link">I am already member</a>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}